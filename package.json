{
  "name": "codesign-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env --experimental-strip-types server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server.ts",
    "test": "node tests/api.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "playwright": "^1.58.0"
  }
}
